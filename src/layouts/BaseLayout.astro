---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  ogImage?: string;
  rawTitle?: boolean;
  article?: boolean;
  pubDate?: Date;
  updatedDate?: Date;
  tags?: string[];
  wide?: boolean;
}

const {
  title,
  description,
  ogImage = '/og/default.png',
  rawTitle = false,
  article = false,
  pubDate,
  updatedDate,
  tags = [],
  wide = false,
} = Astro.props;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const fullTitle = rawTitle ? title : `${title} | Meridian Build`;
const ogImageURL = new URL(ogImage, Astro.site).toString();
const authorURL = new URL('/about', Astro.site).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="alternate" type="application/rss+xml" title="Meridian Build Blog" href="/rss.xml" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <meta name="yandex-verification" content="4152fecec905a725" />

    <!-- Open Graph -->
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="Meridian Build" />
    <meta property="og:image" content={ogImageURL} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />

    {article && pubDate && (
      <>
        <meta property="article:published_time" content={pubDate.toISOString()} />
        <meta property="article:modified_time" content={(updatedDate || pubDate).toISOString()} />
        <meta property="article:author" content={authorURL} />
        {tags.map((tag) => <meta property="article:tag" content={tag} />)}
      </>
    )}

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@MarcoBlch" />
    <meta name="twitter:creator" content="@MarcoBlch" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageURL} />

    <slot name="head" />
  </head>
  <body>
    <Header />
    <main class:list={[{ wide }]}>
      <slot />
    </main>
    <Footer />
  </body>
</html>
